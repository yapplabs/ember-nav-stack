<div
  id={{this.elementId}}
  class={{concat
    "NavStack "
    (if this.birdsEyeDebugging "is-birdsEyeDebugging ")
    this.layerIndexCssClass
    " "
    (if this.hasFooter "NavStack--withFooter ")
    (if @rootClass (concat " " @rootClass))
  }}
  {{back-swipe
    onReady=this.handleBackSwipeReady
    getCanNavigateBack=this.getCanNavigateBack
    onBack=this.handleBack
    onBackSwipeOverlay=this.handleBackSwipeOverlay
  }}
  {{did-update this.handleStackFingerprintChange this.stackItemsFingerprint}}
  ...attributes
>
  <NavStackInnerWrapper @class={{@innerWrapperClass}}>
    {{#if this.headerIsTop}}
      <div
        class={{concat
          "NavStack-header"
          (if @headerContainerClass (concat " " @headerContainerClass))
        }}
      >
        {{#if this.parentItemHeaderComponent}}
          <div
            class="NavStack-headerContainer NavStack-parentItemHeaderContainer"
            inert={{true}}
          >
            {{#if (has-block "header")}}
              {{yield
                (component
                  this.parentItemHeaderComponent
                  class="NavStack-headerComponent"
                  back=@back
                )
                to="header"
              }}
            {{else}}
              {{component
                this.parentItemHeaderComponent
                class="NavStack-headerComponent"
                back=@back
              }}
            {{/if}}
          </div>
        {{/if}}
        <div class="NavStack-headerContainer NavStack-currentHeaderContainer">
          {{#if (has-block "header")}}
            {{yield
              (component
                this.headerComponent class="NavStack-headerComponent" back=@back
              )
              to="header"
            }}
          {{else}}
            {{component
              this.headerComponent
              class="NavStack-headerComponent"
              back=@back
            }}
          {{/if}}
        </div>
      </div>
    {{/if}}
    <div
      class={{concat
        "NavStack-itemContainer"
        (if @itemContainerClass (concat " " @itemContainerClass))
      }}
    >
      {{#each this.renderableEntries as |entry|}}
        <div
          class={{concat "NavStack-item NavStack-item-" entry.index}}
          inert={{entry.isInert}}
        >
          {{#if entry.shouldRender}}
            {{component entry.component}}
          {{/if}}
        </div>
      {{/each}}
    </div>
    {{#unless this.headerIsTop}}
      <div
        class={{concat
          "NavStack-header"
          (if @headerContainerClass (concat " " @headerContainerClass))
        }}
      >
        {{#if this.parentItemHeaderComponent}}
          <div
            class="NavStack-headerContainer NavStack-parentItemHeaderContainer"
            inert={{true}}
          >
            {{#if (has-block "header")}}
              {{yield
                (component
                  this.parentItemHeaderComponent
                  class="NavStack-headerComponent"
                  back=@back
                )
                to="header"
              }}
            {{else}}
              {{component
                this.parentItemHeaderComponent
                class="NavStack-headerComponent"
                back=@back
              }}
            {{/if}}
          </div>
        {{/if}}
        <div class="NavStack-headerContainer NavStack-currentHeaderContainer">
          {{#if (has-block "header")}}
            {{yield
              (component
                this.headerComponent class="NavStack-headerComponent" back=@back
              )
              to="header"
            }}
          {{else}}
            {{component
              this.headerComponent
              class="NavStack-headerComponent"
              back=@back
            }}
          {{/if}}
        </div>
      </div>
    {{/unless}}
    {{yield to="bannerAd"}}
    {{#if this.hasFooter}}
      <div
        class={{concat
          "NavStack-footer"
          (if @footerClass (concat " " @footerClass))
        }}
      >
        {{component @footer}}
      </div>
    {{/if}}
  </NavStackInnerWrapper>
</div>