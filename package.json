{
  "private": true,
  "repository": {
    "type": "git",
    "url": "https://github.com/yapplabs/ember-nav-stack.git"
  },
  "license": "MIT",
  "author": "",
  "scripts": {
    "build": "pnpm --filter ember-nav-stack build",
    "lint": "pnpm --filter '*' lint",
    "lint:fix": "pnpm --filter '*' lint:fix",
    "prepare": "pnpm build",
    "release": "release-it",
    "start": "concurrently 'pnpm:start:*' --restart-after 5000 --prefixColors auto",
    "start:addon": "pnpm --filter ember-nav-stack start --no-watch.clearScreen",
    "start:test-app": "pnpm --filter test-app start",
    "test": "pnpm --filter '*' test",
    "test:ember": "pnpm --filter '*' test:ember"
  },
  "packageManager": "pnpm@10.30.0",
  "devDependencies": {
    "concurrently": "^9.1.2",
    "prettier": "^3.3.3",
    "prettier-plugin-ember-template-tag": "^2.0.4",
    "release-it": "^17.10.0",
    "release-it-lerna-changelog": "^5.0.0"
  },
  "engines": {
    "node": ">= 20.19"
  },
  "volta": {
    "node": "20.19.4",
    "pnpm": "10.30.0"
  },
  "release-it": {
    "plugins": {
      "release-it-lerna-changelog": {
        "infile": "CHANGELOG.md",
        "launchEditor": false
      }
    },
    "git": {
      "tagName": "v${version}",
      "commitMessage": "Release ${version}"
    },
    "github": {
      "release": true,
      "tokenRef": "GITHUB_AUTH"
    },
    "hooks": {
      "after:bump": "pnpm --filter ember-nav-stack version ${version} --no-git-tag-version --allow-same-version && git add ember-nav-stack/package.json"
    }
  }
}
